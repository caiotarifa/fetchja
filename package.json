{
  "name": "fetchja",
  "version": "3.2.0",
  "type": "module",
  "description": "A super simple, modern, lightweight, zero-dependency JSON:API client built on the Fetch API.",
  "author": "Caio Tarifa <caio@yahoo.com>",
  "license": "ISC",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./atomic": {
      "types": "./dist/atomic.d.ts",
      "import": "./dist/atomic.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/atomic.ts --format esm --minify --sourcemap --clean && tsc -p tsconfig.build.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caiotarifa/fetchja.git"
  },
  "bugs": {
    "url": "https://github.com/caiotarifa/fetchja/issues"
  },
  "homepage": "https://github.com/caiotarifa/fetchja#readme"
}
