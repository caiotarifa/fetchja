---
interface Props {
  accent?: boolean
}

const { accent = false } = Astro.props
---

<span
  class:list={[
    'inline-block rounded-md border bg-(--code-bg) px-2 py-0.5',
    'font-mono text-[11.5px] text-text',
    accent && 'border-accent/35 text-accent',
    !accent && 'border-border'
  ]}
>
  <slot />
</span>
