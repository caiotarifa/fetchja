<button
  class="theme-toggle grid size-9.5 place-items-center rounded-[10px]
    border border-border bg-surface text-text-mut transition duration-150
    hover:-translate-y-px hover:border-border-2 hover:text-text"
  id="themeToggle"
  aria-label="Toggle theme"
  title="Toggle theme"
>
  <svg
    class="sun size-4.5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-linecap="round"
    stroke-width="2"
  >
    <circle cx="12" cy="12" r="4" />
    <path
      d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4
        M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    />
  </svg>
  <svg
    class="moon size-4.5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-linecap="round"
    stroke-linejoin="round"
    stroke-width="2"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
  </svg>
</button>

<style>
  .moon {
    display: none;
  }

  :global([data-theme="dark"]) .sun {
    display: none;
  }

  :global([data-theme="dark"]) .moon {
    display: block;
  }
</style>
