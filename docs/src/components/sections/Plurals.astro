---
import DocSection from '../common/DocSection.astro'
import CodeBlock from '../ui/CodeBlock.astro'
import InlineCode from '../ui/InlineCode.astro'
import {
  CUSTOM_PLURAL_CODE,
  NO_PLURAL_CODE
} from '../../lib/content'
---

<DocSection
  id="plurals"
  kicker="Plurals"
  title="Use the built-in pluralizer or replace it."
  tone="muted"
>
  <Fragment slot="lede">
    Fetchja pluralizes resource names by default and avoids simple
    double-plurals. For domain-specific words, pass a function or set
    <InlineCode>pluralize: false</InlineCode> and use exact resource names.
  </Fragment>

  <h3
    class="mb-3.5 flex items-center gap-3 text-[21px] font-semibold
      tracking-normal text-text"
  >
    <span class="font-mono text-lg font-medium text-accent/60">#</span>
    Bring a specialized library
  </h3>
  <p class="mb-5 max-w-[44em] text-text-mut">
    For irregular words like <InlineCode>person</InlineCode> to
    <InlineCode>people</InlineCode>, inject a library such as
    <a
      class="text-accent underline decoration-accent/40 underline-offset-4
        transition hover:decoration-accent"
      href="https://www.npmjs.com/package/pluralize"
      target="_blank"
      rel="noopener"
    >
      pluralize
    </a>.
  </p>

  <div class="grid gap-4 lg:grid-cols-2">
    <CodeBlock code={CUSTOM_PLURAL_CODE} filename="custom-plural.ts" />
    <CodeBlock code={NO_PLURAL_CODE} filename="no-plural.ts" />
  </div>
</DocSection>
