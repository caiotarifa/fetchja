---
import DocSection from '../common/DocSection.astro'
import InlineCode from '../ui/InlineCode.astro'
import { HERO } from '../../lib/content'
---

<DocSection
  id="install"
  kicker="Install"
  title="One package. No adapter stack."
  tone="muted"
>
  <Fragment slot="lede">
    Fetchja only needs an environment where <InlineCode>fetch</InlineCode>
    exists: Node 18+, Deno, Bun, or any modern browser.
  </Fragment>

  <figure
    class="relative m-0 max-w-xl overflow-hidden rounded-2xl border
      border-accent/30 bg-[oklch(0.20_0.018_var(--accent-h))]
      shadow-[0_1px_2px_oklch(0_0_0/.25),0_20px_50px_var(--glow)]"
  >
    <div
      class="flex items-center gap-2 border-b border-white/10
        bg-white/5 px-4 py-3"
    >
      <div class="flex gap-1.75" aria-hidden="true">
        <span class="block size-2.75 rounded-full bg-red-400"></span>
        <span class="block size-2.75 rounded-full bg-amber-300"></span>
        <span class="block size-2.75 rounded-full bg-emerald-400"></span>
      </div>
      <span class="ml-1 font-mono text-xs text-white/45">bash - install</span>
    </div>
    <div
      class="flex items-center gap-3 px-4 py-5 font-mono text-sm
        sm:px-5 sm:text-[17px]"
    >
      <span class="select-none font-bold text-accent">$</span>
      <code class="whitespace-nowrap text-white">{HERO.installCommand}</code>
      <span class="term-cursor h-5 w-2.5 shrink-0 rounded-sm bg-accent"></span>
      <button
        class="ml-auto inline-flex items-center gap-2 whitespace-nowrap
          rounded-[9px] border border-accent/45 bg-accent/15 px-3.5 py-2
          font-mono text-[12.5px] font-semibold text-white/90 transition
          hover:-translate-y-px hover:bg-accent [&.copied]:border-accent
          [&.copied]:bg-accent [&.copied]:text-white"
        data-copy={HERO.installCommand}
        aria-label="Copy install command"
      >
        <span class="ci [&_svg]:size-3.5">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
          >
            <rect x="9" y="9" width="11" height="11" rx="2" />
            <path d="M5 15V5a2 2 0 0 1 2-2h10" />
          </svg>
        </span>
          <span>Copy</span>
      </button>
    </div>
  </figure>
</DocSection>

<style>
  .term-cursor {
    animation: termcursor 1.05s steps(2) infinite;
  }

  @keyframes termcursor {
    50% {
      opacity: 0;
    }
  }
</style>
