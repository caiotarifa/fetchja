import Hero from '../components/Hero.astro'
import Why from '../components/sections/Why.astro'
import Install from '../components/sections/Install.astro'
import QuickStart from '../components/sections/QuickStart.astro'
import Options from '../components/sections/Options.astro'
import Methods from '../components/sections/Methods.astro'
import Relationships from '../components/sections/Relationships.astro'
import Query from '../components/sections/Query.astro'
import CustomFetch from '../components/sections/CustomFetch.astro'
import Errors from '../components/sections/Errors.astro'
import TanStack from '../components/sections/TanStack.astro'
